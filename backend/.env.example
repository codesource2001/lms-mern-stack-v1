NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
APP_VERSION=0.1.0

# Comma-separated origin allowlist. Never use a wildcard with credentialed requests.
CORS_ORIGINS=http://localhost:5173

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Number of trusted reverse-proxy hops in front of the API. Keep 0 for direct local traffic.
TRUST_PROXY_HOPS=0

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
