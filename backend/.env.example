NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
APP_VERSION=0.1.0

# Comma-separated origin allowlist. Never use a wildcard with credentialed requests.
CORS_ORIGINS=http://localhost:5173

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Number of trusted reverse-proxy hops in front of the API. Keep 0 for direct local traffic.
TRUST_PROXY_HOPS=0

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

# Interactive Swagger UI and /api-docs/openapi.json.
# Defaults to true outside production and false in production. Override deliberately.
# ENABLE_API_DOCS=false

# Local Compose defaults. If you change MONGO_PORT or REDIS_PORT in the root .env,
# update these URLs to match. Never reuse these credentials outside a developer machine.
MONGODB_URI=mongodb://atrium:local-dev-only-change-me@localhost:27017/atrium?authSource=admin
MONGODB_MAX_POOL_SIZE=10
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000

REDIS_URL=redis://:local-dev-only-change-me@localhost:6379
REDIS_CONNECT_TIMEOUT_MS=5000

# Startup fails after this many attempts. Readiness checks are bounded separately.
DEPENDENCY_RETRY_ATTEMPTS=3
DEPENDENCY_RETRY_DELAY_MS=1000
READINESS_TIMEOUT_MS=2000

# Background jobs: the worker runs in-process unless disabled explicitly.
# It defaults to off when NODE_ENV=test.
# JOBS_WORKER_ENABLED=false
JOBS_POLL_INTERVAL_MS=1000
JOBS_JOB_LEASE_MS=30000
JOBS_MAX_ATTEMPTS=3
JOBS_CLAIM_LIMIT=20
JOBS_REMINDER_INTERVAL_MS=900000
JOBS_REMINDER_WINDOW_MS=86400000
