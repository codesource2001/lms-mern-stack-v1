{
  "name": "@atrium/backend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:file": "eslint --fix",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "seed": "tsx src/seeds/seed.cli.ts",
    "seed:prod": "node dist/seeds/seed.cli.js"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "9.1.0",
    "argon2": "0.45.2",
    "compression": "1.8.2",
    "cookie-parser": "1.4.7",
    "cors": "2.8.6",
    "dotenv": "18.0.10",
    "express": "5.3.0",
    "express-rate-limit": "8.7.5",
    "helmet": "8.3.0",
    "jsonwebtoken": "9.0.3",
    "mongoose": "9.13.0",
    "nodemailer": "10.6.1",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "redis": "6.4.0",
    "swagger-ui-express": "5.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/compression": "1.8.1",
    "@types/cookie-parser": "1.4.10",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "24.19.2",
    "@types/nodemailer": "8.0.2",
    "@types/supertest": "7.2.1",
    "@types/swagger-ui-express": "4.1.8",
    "@vitest/coverage-v8": "5.1.1",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.14.0",
    "pino-pretty": "13.2.0",
    "supertest": "7.3.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.74.0",
    "vitest": "5.1.1"
  }
}
