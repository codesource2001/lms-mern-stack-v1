# Production deployment configuration — replace every placeholder before use.
# Never commit a filled-in copy of this file.

HTTP_PORT=80
APP_VERSION=0.1.0
LOG_LEVEL=info
ENABLE_API_DOCS=false

# Public https origin and matching CORS allowlist (comma-separated).
APP_WEB_URL=https://atrium.example.com
CORS_ORIGINS=https://atrium.example.com

# Infrastructure credentials. Generate unique values with a password manager.
MONGO_ROOT_USER=atrium
MONGO_ROOT_PASSWORD=replace-with-a-long-random-value
REDIS_PASSWORD=replace-with-a-long-random-value

# Auth secrets must be different from each other and at least 32 characters.
AUTH_JWT_SECRET=replace-with-a-long-random-jwt-secret
AUTH_METADATA_SECRET=replace-with-a-different-long-random-secret

# SMTP is required by environment validation in production.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=replace-with-smtp-user
SMTP_PASSWORD=replace-with-smtp-password
EMAIL_FROM=Atrium LMS <no-reply@atrium.example.com>

# Run the background worker in the API process until it is split out in a later phase.
JOBS_WORKER_ENABLED=true
