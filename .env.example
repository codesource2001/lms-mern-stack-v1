# Local infrastructure only. Copy to .env before running `docker compose up -d`.
# These defaults are development credentials, never reuse them outside local machines.
MONGO_ROOT_USERNAME=atrium
MONGO_ROOT_PASSWORD=local-dev-only-change-me
MONGO_PORT=27017

REDIS_PASSWORD=local-dev-only-change-me
REDIS_PORT=6379

# If 27017 or 6379 are already in use, change the host ports here and update
# MONGODB_URI / REDIS_URL in backend/.env to match. Keep both files in sync.
